# Public domain of the stack. Host names are portail.<DOMAIN>, docs.<DOMAIN> and
# tdf.<DOMAIN>, plus idp.<DOMAIN> for the local IdP of the standalone profile.
# dcs.test works locally and in CI with the standalone profile.
DOMAIN=dcs.test

# Standalone mode (local development, CI, isolated demos): a local reverse
# proxy with its own CA and a local IdP. Leave empty for the hosted mode.
COMPOSE_PROFILES=standalone

# Address the standalone reverse proxy listens on (port 443).
PROXY_BIND=127.0.0.1

# Hosted mode: an external reverse proxy terminates TLS and forwards to these
# ports, published on BIND_ADDRESS only (see docs/hosting.md).
BIND_ADDRESS=127.0.0.1
PORTAL_PORT=6140
DOCS_PORT=6141
TDF_PORT=6142

# Secret shared by the portal and ONLYOFFICE Docs to sign editor configurations
# and callbacks. Generate one with: openssl rand -hex 32
ONLYOFFICE_JWT_SECRET=

# OpenID Connect provider of the portal. The standalone profile runs a local
# LemonLDAP::NG at https://idp.<DOMAIN>/ (keep the trailing slash) with
# fictional accounts. For a hosted demo, use the issuer exactly as the SSO's
# discovery document spells it, the client registered there (redirect URI
# https://portail.<DOMAIN>/auth/callback) and its secret.
OIDC_ISSUER=https://idp.dcs.test/
# The client id and the groups dcs-maquette and dcs-maquette-admin are the
# names registered at the corporate SSO; the local IdP uses the same ones.
OIDC_CLIENT_ID=dcs-maquette
# Shared with the local IdP in the standalone profile.
OIDC_CLIENT_SECRET=
# The local IdP only releases the groups claim when the groups scope is asked.
OIDC_SCOPES=openid profile email groups
# Audience OpenTDF expects in access tokens. It defaults to the platform's own
# URL, https://tdf.<DOMAIN>, which the local IdP adds to the tokens it issues.
# A hosted SSO needs the same additional audience on its client; otherwise set
# the audience it does issue, often the client id.
# OIDC_AUDIENCE=

# Language of the markings the policy service renders. Without a SPIF phrase
# in that language, the language-neutral phrase or the name itself is used.
MARKING_LANGUAGE=fr
# Rule for the document label: clear-parts keeps the base label and adds the
# SPIF's indicator when a portion is more restrictive; high-water-mark takes
# the ADatP-4774.1 dominant label of the base and every portion.
ROLLUP_RULE=clear-parts

# Password of the OpenTDF platform's PostgreSQL database.
OPENTDF_DB_PASSWORD=
