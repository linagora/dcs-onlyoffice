# Public domain of the stack. Host names are portail.<DOMAIN>, docs.<DOMAIN> and
# tdf.<DOMAIN>, plus idp.<DOMAIN> for the local IdP of the standalone profile.
# dcs.localhost works locally and in CI with the standalone profile: Chrome
# and Firefox reach its host names without any change to /etc/hosts.
DOMAIN=dcs.localhost

# Standalone mode (local development, CI, isolated demos): a local reverse
# proxy with its own CA and a local IdP. Leave empty for the hosted mode.
COMPOSE_PROFILES=standalone

# Address the standalone reverse proxy listens on (port 443).
PROXY_BIND=127.0.0.1

# Hosted mode: an external reverse proxy terminates TLS and forwards to these
# ports, published on BIND_ADDRESS only (see docs/hosting.md).
BIND_ADDRESS=127.0.0.1
PORTAL_PORT=6140
DOCS_PORT=6141
TDF_PORT=6142

# Secret shared by the portal and ONLYOFFICE Docs to sign editor configurations
# and callbacks. Generate one with: openssl rand -hex 32
ONLYOFFICE_JWT_SECRET=

# OpenID Connect provider of the portal. The standalone profile runs a local
# LemonLDAP::NG at https://idp.<DOMAIN>/ (keep the trailing slash) with
# fictional accounts. For a hosted demo, use the issuer exactly as the SSO's
# discovery document spells it, the client registered there (redirect URI
# https://portail.<DOMAIN>/auth/callback) and its secret.
OIDC_ISSUER=https://idp.dcs.localhost/
# The client id and the groups dcs-maquette and dcs-maquette-admin are the
# names registered at the corporate SSO; the local IdP uses the same ones.
OIDC_CLIENT_ID=dcs-maquette
# Shared with the local IdP in the standalone profile.
OIDC_CLIENT_SECRET=
# The local IdP only releases the groups claim when the groups scope is asked.
OIDC_SCOPES=openid profile email groups
# Secret of dcs-provisioner, the client the provisioning job uses to write
# OpenTDF's attributes, with the client credentials grant only. Shared with the
# local IdP in the standalone profile; a hosted SSO registers the client and
# gives its secret.
OPENTDF_PROVISIONER_CLIENT_SECRET=
# Audience OpenTDF expects in access tokens. It defaults to the platform's own
# URL, https://tdf.<DOMAIN>, which the local IdP adds to the tokens it issues.
# A hosted SSO needs the same additional audience on its client; otherwise set
# the audience it does issue, often the client id.
# OIDC_AUDIENCE=

# Language of the editor and of its labelling panel: en (default) or fr. A
# document opened with ?lang=fr or ?lang=en in its address uses that language
# for the session instead. Markings keep MARKING_LANGUAGE.
EDITOR_LANGUAGE=en

# Language of the markings the policy service renders. Without a SPIF phrase
# in that language, the language-neutral phrase or the name itself is used.
MARKING_LANGUAGE=fr
# Rule for the document label: clear-parts keeps the base label and adds the
# SPIF's indicator when a portion is more restrictive; high-water-mark takes
# the ADatP-4774.1 dominant label of the base and every portion.
ROLLUP_RULE=clear-parts

# How long, in seconds, an author keeps a portion lock without renewing it;
# the panel renews it while its edit form stays open. 20 keeps the standalone
# profile's test of an abandoned lock short; a hosted stack uses 300, the
# default when this setting is absent.
PORTION_LOCK_LEASE_SECONDS=20

# The label mapping of a Microsoft 365 tenant, which gives each stored
# document its sensitivity label. The standalone profile loads the example of
# the demo policy, which names a fictional tenant; a hosted stack leaves it
# empty until it has the mapping of a real tenant (docs/hosting.md).
LABEL_MAPPING_FILE=/spif/demo-fr.label-mapping.json

# Password of the stack's PostgreSQL superuser, `opentdf`, which only the
# database setup job uses.
OPENTDF_DB_PASSWORD=

# Password of the OpenTDF platform's database role, which may create schemas
# and owns the platform's, but has no right on the clearance directory.
OPENTDF_PLATFORM_DB_PASSWORD=

# Root key of OpenTDF's key registry, 32 bytes in hex: it wraps the private
# half of every KAS key the registry holds. Losing it loses every envelope.
OPENTDF_KAS_ROOT_KEY=

# Passwords of the clearance directory's database roles: the policy service
# owns the directory, and OpenTDF only reads it.
DIRECTORY_DB_PASSWORD=
DIRECTORY_READER_PASSWORD=

# Shared by the portal and the policy service: only the portal, on its page
# reserved to administrators, may change the clearance directory.
DIRECTORY_ADMINISTRATION_SECRET=
# The key that signs the document label's binding at each save, and its
# certificate, as base64-encoded PEM: init-env.sh generates a demo key with a
# self-signed certificate; docs/hosting.md tells how to use one that a PKI
# issues. The portal holds the secret it shares with the policy service to
# have bindings signed.
BINDING_SIGNING_KEY=
BINDING_SIGNING_CERTIFICATE=
BINDING_SIGNATURE_SECRET=
